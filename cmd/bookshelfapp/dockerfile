FROM golang:1.27.1-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -tags timetzdata -o /app/cmd/bookshelfapp/exe /app/cmd/bookshelfapp

FROM alpine:3.24
WORKDIR /app

RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app \
    && mkdir -p /app/out/logs && chown -R app:app /app/out

COPY --from=builder --chown=app:app /app/cmd/bookshelfapp/exe /app/exe

USER app
CMD ["/app/exe"]